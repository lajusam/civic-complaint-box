# Solana Network Configuration
# Options: devnet, testnet, mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com

# Smart Contract Configuration
# REQUIRED: Replace with your deployed Solana program ID
# Deploy your Anchor contract and get the program ID from Anchor.toml
NEXT_PUBLIC_COMPLAINT_PROGRAM_ID=11111111111111111111111111111111

# IPFS / Pinata Configuration (for uploading complaints and images)
# Get your API keys from: https://www.pinata.cloud/
# Leave as demo_key/demo_secret for testing (will use mock data)
NEXT_PUBLIC_PINATA_API_KEY=demo_key
NEXT_PUBLIC_PINATA_API_SECRET=demo_secret

# Optional: Custom IPFS Gateway
# Leave empty to use default Pinata gateway
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Admin Wallet Address
# Replace with your Solana wallet public key (base58 encoded)
NEXT_PUBLIC_ADMIN_WALLET=11111111111111111111111111111111

# RPC Endpoint (same as network RPC)
NEXT_PUBLIC_RPC_ENDPOINT=https://api.devnet.solana.com
